APP_NAME=LabInventory
ENVIRONMENT=development
API_VERSION=v1
PROTOCOL_VERSION=1
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=labinventory
POSTGRES_USER=labinventory
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://labinventory:change-me-for-local-development@db:5432/labinventory

UPLOAD_ROOT=/data/uploads
INSTANCE_DATA_ROOT=/data/instance

MDNS_ENABLED=false
MDNS_SERVICE_NAME=LabInventory Backend
MDNS_SERVICE_TYPE=_labinventory._tcp.
MDNS_ADVERTISE_IP=
MDNS_FAIL_FAST=false
